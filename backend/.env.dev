# Committed development defaults - the app runs out of the box with these.
# Copy to .env and edit for anything local/private; .env always wins.
APP_NAME=AIRA (local dev)
ENVIRONMENT=development
SECRET_KEY=local-dev-secret-change-me-please-rotate
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Demo accounts created on first start / `scripts/seed_demo.py`
BOOTSTRAP_ADMIN_EMAIL=admin@aira.test
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_USER_EMAIL=engineer@aira.test
BOOTSTRAP_USER_PASSWORD=Engineer@123

# LLM is optional: without GROQ_API_KEY the assistant answers in
# deterministic grounded mode (evidence-only, fully reproducible).
GROQ_API_KEY=
LLM_ENABLED=auto
EMBEDDING_PROVIDER=auto
RETRIEVAL_K=28
LOG_LEVEL=INFO
