# ============================================================================
# AI Incident Resolution Assistant - backend environment configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ============================================================================

APP_NAME="AI Incident Resolution Assistant"
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=..          # project root; resolved data dir = DATA_DIR/data
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Production / docker-compose:
# DATABASE_URL=postgresql+psycopg2://aira:aira@localhost:5432/aira
# Dev fallback (works without Postgres):
DATABASE_URL=sqlite:///../data/aira.db

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-min-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_EMAIL=admin@aira.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
# Optional non-admin demo login, created by the seed script / on startup when set
BOOTSTRAP_USER_EMAIL=engineer@aira.test
BOOTSTRAP_USER_PASSWORD=Engineer@123

# --- Groq LLM (optional: system runs in grounded deterministic mode without) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# LLM_ENABLED=auto        # auto | true | false  (true requires GROQ_API_KEY)

# --- Embeddings -------------------------------------------------------------
# fastembed (ONNX, default) | sentence-transformers (heavier, needs torch) | lightweight
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval / Self-Healing RAG tuning -------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=140
RETRIEVAL_K=24
RETRIEVAL_SCORE_THRESHOLD=0.28
RETRIEVAL_MAX_PER_CATEGORY=4
MAX_RETRIEVAL_ATTEMPTS=3
SIMILAR_INCIDENT_TOP_K=5
SIMILAR_INCIDENT_SCORE_THRESHOLD=0.45
EVIDENCE_MIN_SCORE=0.3
CONFIDENCE_GOOD_THRESHOLD=0.72
